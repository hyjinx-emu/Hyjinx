<Project>
  <Import Project="./shared.props" />
  
  <PropertyGroup>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <PropertyGroup>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  
</Project>